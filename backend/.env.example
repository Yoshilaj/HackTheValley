# Copy to .env and fill in. Never commit .env.
# This file is committed: put PLACEHOLDERS here only, never real keys or passwords.
APP_NAME=HackTheValley API
# CORS: the deployed frontend origin (Vercel/Netlify) in production.
FRONTEND_ORIGIN=http://localhost:5173
# Public URL of this backend (report share links, OAuth redirects, mock clinic, webhooks).
# ElevenLabs / Resend webhooks need a PUBLIC HTTPS URL (deployment or a tunnel such as ngrok).
BASE_URL=http://localhost:8000

# --- Database
# Local: SQLite (default below).
# Cloud: the Neon connection string, set on the server (Render), not here.
#   postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=sqlite:///./data/dev.db

# --- Auth / security (use different values locally and on the server)
# Long random string: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_DAYS=7
# Sent as X-Admin-Secret header for admin endpoints (e.g. POST /api/risk/run). Same command as above.
ADMIN_SECRET=change-me
# Fernet key for encrypting OAuth tokens:
#   .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If empty and DEV_MODE=true an ephemeral key is generated (encrypted data won't survive restarts).
FIELD_ENCRYPTION_KEY=
# true = allow the X-User-Id header shortcut + ephemeral keys. MUST be false in production.
DEV_MODE=true

# --- Storage / logging
STORAGE_DIR=./data/uploads
# local = files under STORAGE_DIR; database = in Postgres (stored_files), for hosts whose disk is
# wiped on redeploy (Render free). Apple Health exports always stay on disk (parsed, not kept).
STORAGE_BACKEND=local
LOG_LEVEL=INFO
LOG_JSON=false

# --- AI providers
# Gemini (chat, extraction, booking agent, image reading). aistudio.google.com -> Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash             # chat, booking agent, vision
GEMINI_CHEAP_MODEL=gemini-3.5-flash-lite  # extraction / classification
# ElevenLabs (speech-to-text with word timestamps + story audio + the phone agent).
# elevenlabs.io -> Developers -> API Keys; enable Text to Speech, Speech to Text AND
# Agents / Conversational AI (ConvAI) permissions for the phone booking channel.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL  # premade "Sarah" (free plan: premade voices only)
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1
# Optional alternatives (leave empty unless you switch to them)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=
# Hugging Face Hub: HF_TOKEN publishes the PD vowel model (`python -m ml_training.train_pd_vowel --push-to-hub`)
# and downloads it from a private repo when models/pd_vowel_experimental_v1/ is absent (e.g. in Docker).
# Pin the revision to the commit sha printed by the push so serving never silently changes.
HF_TOKEN=
PD_VOWEL_HUB_REPO=            # e.g. your-hf-username/pd-vowel-experimental-v1
PD_VOWEL_HUB_REVISION=main    # commit sha recommended
PD_VOWEL_RULE_ENABLED=false   # keep false until a voice model validated on app-extracted audio is served (PD-03 display-only)

# Provider switches. "fake" = deterministic and offline (tests, no keys).
LLM_PROVIDER=fake          # gemini | anthropic | fake
STT_PROVIDER=fake          # elevenlabs | openai | fake
TTS_PROVIDER=fake          # elevenlabs | openai | fake (story-task audio, cached per story)
EMBEDDING_PROVIDER=fake    # local | voyage | fake

# --- RAG (English corpus; local models via fastembed, downloaded on first use)
# Use the quantized -Q embedder (~130 MB, ~285 MB RSS). Changing the model needs a re-ingest:
#   .venv/bin/python -m scripts.ingest_corpus --provider local
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5-Q
RERANKER=cross_encoder     # cross_encoder (+140 MB RSS, better ranking) | identity (512 MB hosts)
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# Cross-encoder relevance floor: passages scoring below it are dropped (chat then says the library
# has nothing relevant). Calibrated with: .venv/bin/python -m scripts.eval_rag
RAG_MIN_RERANK_SCORE=-6.0
# Bump to invalidate the in-process query cache after a corpus change.
RAG_CORPUS_VERSION=v3
# Optional local-embedder tuning (env only): max tokens per passage (512 on a 512 MB box while
# ingesting) and padded tokens per embedding batch.
# LOCAL_EMBED_MAX_TOKENS=1024
# LOCAL_EMBED_BATCH_TOKENS=512
# Optional: where fastembed stores models (default: a temp dir). The Docker image uses /opt/fastembed.
# FASTEMBED_CACHE_PATH=

# --- Google
# Calendar OAuth: console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID
# (Web application; redirect URI {BASE_URL}/api/integrations/google/callback; enable Google Calendar API).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Clinic discovery: an API key with "Places API (New)" and "Geocoding API" enabled.
# Without it the fictional Toronto seed clinics are used.
GOOGLE_MAPS_API_KEY=

# --- Email (Resend) for booking requests / notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Where booking emails go when a clinic has no email (demo inbox).
CLINIC_FALLBACK_EMAIL=
# auto = Resend when RESEND_API_KEY and RESEND_FROM_EMAIL are set, else fake (logged, not sent)
EMAIL_PROVIDER=auto
# With DEV_MODE=false startup fails unless Resend is configured or EMAIL_PROVIDER=fake.
# resend.com -> API Keys; the From address must be on a verified domain.
# Inbound clinic replies: Resend -> Domains -> enable receiving on a (sub)domain, then
# Webhooks -> add {BASE_URL}/api/webhooks/resend/inbound for "email.received" -> signing secret.
BOOKING_REPLY_DOMAIN=      # e.g. book.example.com (From booking@..., Reply-To book+<token>@...)
RESEND_WEBHOOK_SECRET=     # whsec_... (unsigned webhooks are accepted only with DEV_MODE=true)

# --- Booking agent v2 (docs/specs/booking-v2.md)
# sandbox = every outbound e-mail / call / website booking goes to the SANDBOX_* targets below,
# never to real clinics. live dials and e-mails real clinics: never for the demo.
BOOKING_TARGET_MODE=sandbox
BOOKING_REQUIRE_APPROVAL=true   # one user approval before any outbound contact
SANDBOX_CLINIC_EMAIL=           # an inbox you control (else CLINIC_FALLBACK_EMAIL)
SANDBOX_CLINIC_PHONE=           # E.164, your own (Twilio-verified) phone, e.g. +14165550123
SANDBOX_CLINIC_WEBSITE=         # empty = the built-in mock clinic at {BASE_URL}/mock-clinic
# Website channel (Playwright headless Chromium: python -m playwright install --only-shell chromium).
# ~340 MB peak per run: set false on 512 MB hosts (Render free).
WEB_BOOKING_ENABLED=true
WEB_BOOKING_LOW_MEMORY=true     # single-process Chromium (~340 vs ~480 MB peak)
# Watch the agent fill the mock clinic form live (local demo only; needs a display and the full
# Chromium build: python -m playwright install chromium). Headed mode ignores WEB_BOOKING_LOW_MEMORY.
# The scripts.test_booking --headed / --slow-mo flags override these two for one run.
WEB_BOOKING_HEADED=false
WEB_BOOKING_SLOW_MO_MS=0        # delay per browser action, e.g. 400; the hard timeout grows with it (max 5 min)

# --- Phone channel (ElevenLabs Agents + Twilio)
# Twilio: console.twilio.com -> Account info (SID, auth token) + a number. A trial account can only
# call Verified Caller IDs (Phone Numbers -> Verified Caller IDs): verify your own phone.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=            # E.164, e.g. +16475550100
# Printed by: .venv/bin/python -m scripts.setup_voice_agent --import-number (needs a public https BASE_URL)
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
# Shown ONCE by setup_voice_agent when it creates the post-call webhook: paste it here yourself.
ELEVENLABS_WEBHOOK_SECRET=

# --- Background jobs (APScheduler, in-process; run with 1 worker)
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=America/Toronto

# --- Region (Canada only, English only)
DEFAULT_COUNTRY=CA
EMERGENCY_NUMBER=911
HEALTH_LINE_NUMBER=811
CRISIS_LINE_NUMBER=9-8-8   # Suicide Crisis Helpline (call or text)

# --- Rate limits on /api/chat, /api/chat/voice, /api/uploads/*, /api/tasks/* (per user, else per IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=30/minute

# --- Clinic confirm links: HMAC secret (empty = derived from JWT_SECRET); links expire after 30 days
APPOINTMENT_TOKEN_SECRET=
