{# Body of a user-facing appointment e-mail. Wrapped by app.providers.email.email_shell (brand header,
   title, buttons, disclaimer). Every value is autoescaped. #}
{% if lead %}<p style="margin:0 0 16px">{{ lead }}</p>{% endif %}
{% if banner %}
<p style="margin:0 0 16px;padding:10px 12px;border-radius:8px;background:{{ banner.bg }};color:{{ banner.ink }};font-size:14px">{{ banner.text }}</p>
{% endif %}
{% if hero %}
<div style="margin:0 0 20px;padding:16px;border-radius:10px;background:#e8f0fc">
  <p style="margin:0;font-size:13px;font-weight:600;color:#155bd0;text-transform:uppercase;letter-spacing:.04em">{{ hero.label }}</p>
  <p style="margin:4px 0 0;font-size:20px;font-weight:700;line-height:1.3">{{ hero.value }}</p>
  {% if hero.sub %}<p style="margin:4px 0 0;font-size:14px;color:#6e6e73">{{ hero.sub }}</p>{% endif %}
</div>
{% endif %}
{% for sec in sections %}
<h2 style="margin:20px 0 8px;font-size:15px;font-weight:700">{{ sec.get("title") }}</h2>
{% if sec.get("text") %}<p style="margin:0 0 8px">{{ sec.get("text") }}</p>{% endif %}
{% if sec.get("rows") %}
<table role="presentation" style="border-collapse:collapse;width:100%;font-size:15px">
  {% for label, value in sec.get("rows") %}
  <tr>
    <td style="padding:6px 12px 6px 0;color:#6e6e73;vertical-align:top;white-space:nowrap">{{ label }}</td>
    <td style="padding:6px 0;vertical-align:top">{{ value }}</td>
  </tr>
  {% endfor %}
</table>
{% endif %}
{% if sec.get("items") %}
<ul style="margin:0;padding-left:20px">
  {% for item in sec.get("items") %}<li style="margin:0 0 6px">{{ item }}</li>{% endfor %}
</ul>
{% endif %}
{% if sec.get("links") %}
<p style="margin:8px 0 0">{% for url, label in sec.get("links") %}<a href="{{ url }}" style="color:#155bd0;font-weight:600;margin-right:16px">{{ label }}</a>{% endfor %}</p>
{% endif %}
{% if sec.get("note") %}<p style="margin:8px 0 0;font-size:13px;color:#6e6e73">{{ sec.get("note") }}</p>{% endif %}
{% endfor %}
{% if closing %}<p style="margin:20px 0 0">{{ closing }}</p>{% endif %}
