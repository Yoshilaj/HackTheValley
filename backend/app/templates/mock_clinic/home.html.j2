{% extends "base.html.j2" %}
{% block body %}
<section class="hero"><div class="wrap">
  <h1>{{ clinic.name }}</h1>
  <p>{{ clinic.tagline }}</p>
  {% if variant.booking == "email" %}
  <p>We do not take online bookings. To request an appointment, e-mail
    <a href="mailto:{{ clinic.email }}?subject=Appointment%20request">{{ clinic.email }}</a> or call {{ clinic.phone }}.</p>
  {% else %}
  <a class="btn" href="{{ p }}/book">Book online</a>
  <span class="hint">&nbsp; or call {{ clinic.phone }}</span>
  {% endif %}
</div></section>
<main class="wrap">
  <h2 id="services">Services</h2>
  <div class="grid">
    {% for title, text in clinic.services %}<div class="card"><h3>{{ title }}</h3><p>{{ text }}</p></div>{% endfor %}
  </div>
  <p class="hint">New patients are welcome. Specialist consultations may need a referral from your family doctor.</p>
  <div class="grid" style="margin-top:24px">
    <div>
      <h2 id="hours">Hours</h2>
      <table class="hours">{% for day, text in hours %}<tr><td>{{ day }}</td><td>{{ text }}</td></tr>{% endfor %}</table>
      <p class="hint">Closed 12:00–1:00 PM for lunch. Times are Eastern Time.</p>
    </div>
    <div>
      <h2 id="contact">Contact</h2>
      <p>{{ clinic.address }}<br>Phone: {{ clinic.phone }}<br>Fax: {{ clinic.fax }}<br>
      E-mail: <a href="mailto:{{ clinic.email }}">{{ clinic.email }}</a></p>
      <p class="hint">Steps from the 501 Queen streetcar. Wheelchair accessible entrance on Dovercourt Rd.</p>
    </div>
  </div>
</main>
{% endblock %}
