<!doctype html>
<html lang="en">
<body style="margin:0;padding:0;background:#f4f6f8;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1b1f24;">
<div style="max-width:600px;margin:0 auto;padding:24px 16px;">
  <div style="background:#ffffff;border-radius:8px;padding:24px;border:1px solid #d7dce2;">
    {% if sandbox_note %}<p style="margin:0 0 12px;padding:8px 10px;background:#fff4d6;border-radius:4px;font-size:13px;color:#7a5200;">Sandbox test message — {{ sandbox_note }}</p>{% endif %}
    {% if reminder %}<p style="margin:0 0 12px;color:#9a5b00;font-weight:600;">{{ L.reminder }}</p>{% endif %}
    <h1 style="font-size:18px;margin:0 0 12px;">{{ L.heading }}</h1>
    <p style="margin:0 0 12px;">{{ L.greeting }} {{ clinic_name }},</p>
    <p style="margin:0 0 12px;">{{ L.intro }}</p>
    <table style="border-collapse:collapse;margin:0 0 16px;font-size:14px;">
      <tr><td style="padding:3px 12px 3px 0;color:#5b6470;">{{ L.patient }}</td><td>{{ patient_name }}</td></tr>
      {% for label, value in details %}
      <tr><td style="padding:3px 12px 3px 0;color:#5b6470;">{{ label }}</td><td>{{ value }}</td></tr>
      {% endfor %}
      <tr><td style="padding:3px 12px 3px 0;color:#5b6470;">{{ L.reason }}</td><td>{{ reason }}</td></tr>
      {% if note %}<tr><td style="padding:3px 12px 3px 0;color:#5b6470;">{{ L.note }}</td><td>{{ note }}</td></tr>{% endif %}
    </table>
    <p style="margin:0 0 8px;font-weight:600;">{{ L.report }}</p>
    <p style="margin:0 0 16px;"><a href="{{ report_url }}" style="color:#1f5f8b;">{{ report_url }}</a></p>
    <p style="margin:0 0 8px;font-weight:600;">{{ L.slots }}</p>
    <ol style="margin:0 0 16px;padding-left:20px;">
      {% for s in slots %}
      <li style="margin-bottom:10px;">{{ s.label }}<br>
        <a href="{{ s.confirm_url }}" style="display:inline-block;margin-top:4px;padding:6px 12px;background:#1f5f8b;color:#ffffff;text-decoration:none;border-radius:4px;font-size:13px;">{{ L.confirm }}</a>
      </li>
      {% endfor %}
    </ol>
    <p style="margin:0 0 12px;font-size:13px;color:#5b6470;">{{ L.other_time }}{% if reply_to %} ({{ reply_to }}){% endif %}.</p>
    <p style="margin:0 0 12px;font-size:13px;color:#5b6470;">{{ L.referral }}</p>
    <p style="margin:0;font-size:12px;color:#5b6470;">{{ L.footer }}</p>
  </div>
</div>
</body>
</html>
