# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*

# Python / backend
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Data & models (large files, keep out of git)
backend/data/raw/*
backend/data/processed/*
!backend/data/raw/.gitkeep
!backend/data/processed/.gitkeep
backend/models/*
!backend/models/pd_vowel_experimental_v1/
!backend/models/pd_vowel_experimental_v1/**
*.pkl
*.pt
*.bin
*.faiss

# Env / secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
.vscode/
.idea/

# local dev database and uploaded files
backend/data/dev.db
backend/data/*.db
backend/data/uploads/
backend/data/*.db-wal
backend/data/*.db-shm
backend/data/*.db-journal

# iOS companion app build output
ios/build/
ios/**/xcuserdata/
